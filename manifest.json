{
    "manifest_version": 3,

    "default_locale": "en",

    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "homepage_url": "https://github.com/Jalkhov/youtube-watchmarker-redo",

    "version": "5.3.1",

    "permissions": [
        "alarms",
        "cookies",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "history",
        "scripting",
        "storage",
        "tabs",
        "webRequest"
    ],

    "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],

    "options_ui": {
        "page": "content/index.html",
        "open_in_tab": true
    },

    "icons": {
        "32": "content/icon-32.png",
        "64": "content/icon-64.png",
        "128": "content/icon.png"
    },

    "background": {
        "scripts": ["idb.js", "background.js"]
    },

    "content_scripts": [{
        "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
        "css": [],
        "js": ["youtube.js"],
        "run_at": "document_start",
        "world": "ISOLATED"
    }, {
        "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
        "css": [],
        "js": ["hooks.js"],
        "run_at": "document_start",
        "world": "MAIN"
    }],

    "action": {
        "default_title": "__MSG_actionTitle__",
        "default_icon": {
            "60": "content/icon.png"
        }
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "youtube-watchmarker-redo@jalkhov",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
